{
  "folders": [
    {
      "path": "api_server",
    },
    {
      "path": "tendon_loader",
    }
  ],
  "settings": {
    "editor.foldingImportsByDefault": true,
    "dart.flutterCreateOrganization": "me.mitul",
    "dart.flutterSdkPath": "/Users/mitulvaghamshi/flutter/bin",
    "dart.flutterCreatePlatforms": [
      "macos"
    ],
    "[dart]": {
      "editor.defaultFormatter": "Dart-Code.dart-code"
    },
  },
  "extensions": {
    "recommendations": [
      "Dart-Code.flutter",
      "Dart-Code.dart-code",
      "GitHub.github-vscode-theme",
      "vscode-icons-team.vscode-icons",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "type": "shell",
        "label": "Server:start",
        "command": "dart bin/server.dart",
        "options": {
          "cwd": "${workspaceFolder}/api_server",
          "env": {
            "PORT": "${input:port}",
            "DB_PATH": "${input:dbPath}",
          },
        },
      },
      {
        "type": "shell",
        "label": "Run app:macOS",
        "command": "flutter run -d macos --dart-define-from-file=.env",
      },
      {
        "type": "shell",
        "label": "Install: pods:iOS",
        "command": "pod install",
        "options": {
          "cwd": "${workspaceFolder}/tendon_loader/ios",
        },
      },
      {
        "type": "shell",
        "label": "Install: pods:macOS",
        "command": "pod install",
        "options": {
          "cwd": "${workspaceFolder}/tendon_loader/macos",
        },
      },
      {
        "type": "shell",
        "group": "build",
        "label": "Run: build_runner:build clean",
        "command": "dart run build_runner build clean",
        "options": {
          "cwd": "${workspaceFolder}/tendon_loader"
        },
      },
    ],
    "inputs": [
      {
        "id": "port",
        "type": "promptString",
        "default": "3001",
        "description": "Enter port number",
      },
      {
        "id": "dbPath",
        "type": "promptString",
        "default": "${workspaceFolder}/api_server/db/db.sqlite",
        "description": "Select database file",
      },
    ],
  },
}
